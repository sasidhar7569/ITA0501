import cv2

img = cv2.imread("flower.jpg")

if img is None:
    print("Image not found")
else:
    img = cv2.resize(img, (600, 400))

    roi = img[50:200, 50:200]

    img[220:370, 350:500] = roi

    cv2.imshow("Original Image", cv2.resize(cv2.imread("flower.jpg"), (600, 400)))
    cv2.imshow("ROI Copied Image", img)

    cv2.waitKey(0)
    cv2.destroyAllWindows()
